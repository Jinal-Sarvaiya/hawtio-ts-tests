# Hawtio E2E Test Configuration
# Copy this file to .env and update with your values

# Spring Boot Hawtio application URL
# Default for Spring Boot Actuator: http://localhost:10001/actuator/hawtio/
HAWTIO_URL=http://localhost:10001/actuator/hawtio/

# Optional: Hawtio credentials (defaults to hawtio/hawtio)
HAWTIO_USER=hawtio
HAWTIO_PASS=hawtio

# Optional: Path to Spring Boot application directory for auto-start
# HAWTIO_APP_DIR=/path/to/your/springboot-app